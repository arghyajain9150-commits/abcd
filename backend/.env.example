# CHAMP Environment Variables
# Copy this to .env and fill in your real values

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT
JWT_SECRET=champ_super_secret_key_change_in_production

# Supabase / PostgreSQL
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# Email (Resend.com - free 3000 emails/month)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@yourcampus.edu

# SMS - optional (Fast2SMS for India)
FAST2SMS_API_KEY=your_fast2sms_key
