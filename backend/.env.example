# CHAMP Backend — Environment Variables
# Copy this file to .env and fill in real values

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Supabase: Settings > Database > Connection string > URI
# Percent-encode special chars in password (& -> %26, / -> %2F)
DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Resend.com — free 3000 emails/month
RESEND_API_KEY=
EMAIL_FROM=CHAMP <noreply@yourdomain.com>
